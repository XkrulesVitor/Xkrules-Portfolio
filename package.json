{
  "name": "meu-portfolio-3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types \"src/**/__tests__/*.test.ts\"",
    "art:layout": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/art/register.mjs scripts/art/export-layout.ts",
    "art:build": "node scripts/art/blender.mjs -b --factory-startup -P art/blender/main.py -- --layout art/build/layout.json --out art/build",
    "art:optimize": "node scripts/art/optimize.mjs",
    "art": "npm run art:layout && npm run art:build -- --quality final && npm run art:optimize"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@types/three": "^0.186.0",
    "motion": "^13.4.4",
    "next": "16.3.6",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "leva": "^0.10.1",
    "meshoptimizer": "^1.3.0",
    "r3f-perf": "^7.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
